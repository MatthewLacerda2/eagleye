# Copy to .env and adjust. Never commit the real .env.

# Database — accepts postgres:// / postgresql:// (normalized to postgresql+asyncpg://).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5442/eagleye

# Auth — generate a strong random secret in real deployments.
JWT_SECRET=change-me-in-production-min-32-bytes
JWT_ISSUER=eagleye
JWT_AUDIENCE=eagleye-admin
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Seeded on startup if no admin exists.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me

# CORS (comma-separated origins).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Global rate limit applied to every request (empty disables it).
RATE_LIMIT_DEFAULT=10/second

# Frontend dev server pointing at a standalone backend. Vite reads this at
# build time from frontend/ — put it in frontend/.env, not this root .env.
# Unset, the app uses the relative /api/v1 that works behind the proxy.
# VITE_API_URL=http://localhost:8000/api/v1

# --- Eagleye --------------------------------------------------------------------
# Your Anthropic API key. The worker refuses to start without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# The two files you write. Keep real ones in config/local/ (git-ignored).
CATALOG_PATH=config/catalog.example.yaml
SITES_PATH=config/sites.example.yaml
# Where captured frames are stored, and for how many days.
FRAMES_DIR=data/frames
RETENTION_DAYS=14
# Base URL of the admin, used in alert links.
PUBLIC_BASE_URL=http://localhost:3000

# One round per site every N seconds: grab a frame per camera, analyze the changed ones.
ROUND_INTERVAL_SECONDS=120
CAPTURE_TIMEOUT_SECONDS=20
CAPTURE_CONCURRENCY=16
# Frames are downscaled so the long side is at most this many pixels.
FRAME_MAX_SIDE=640

# Change filter: grayscale thumbnail split into a grid; a cell changed when its
# mean difference exceeds the threshold; a frame is sent when enough cells changed.
CHANGE_GRID_COLS=16
CHANGE_GRID_ROWS=12
CHANGE_CELL_THRESHOLD=12.0
CHANGE_MIN_CELLS=2
# A camera sends a frame at least this often, changed or not.
MAX_UNSENT_MINUTES=60
# Cells that change in most captures (clocks, flicker) are ignored automatically.
AUTOMASK_WINDOW=30
AUTOMASK_MIN_SAMPLES=10
AUTOMASK_RATIO=0.8

# Claude calls.
ANALYSIS_MAX_TOKENS=4000
ANALYSIS_CONCURRENCY=8
MAX_CAMERAS_PER_CALL=20
# Model calls stop for the rest of the UTC day once today's spend reaches this.
DAILY_BUDGET_USD=25
# Keep each site's prompt cache warm when it has been idle this long (< 60).
KEEPALIVE_ENABLED=true
KEEPALIVE_AFTER_MINUTES=55
# Prices per million tokens, used for the cost metrics.
PRICE_INPUT_PER_MTOK=0.10
PRICE_OUTPUT_PER_MTOK=0.50
PRICE_CACHE_READ_MULT=0.1
PRICE_CACHE_WRITE_1H_MULT=2.0

# Alerts: comma-separated webhook URLs (empty = alerts only in the admin), and an
# optional secret to sign them (X-Eagleye-Signature: sha256=<hmac>).
ALERT_WEBHOOK_URLS=
ALERT_WEBHOOK_SECRET=
ALERT_COOLDOWN_MINUTES=10
METRICS_PORT=9100
# Grafana admin password (compose profile "monitoring").
GRAFANA_ADMIN_PASSWORD=change-me
